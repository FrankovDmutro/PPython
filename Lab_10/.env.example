# Application Configuration
APP_NAME=Scientific Experiments Registry
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database Configuration (SQLite for local/docker volume, PostgreSQL for enterprise production)
DATABASE_URL=sqlite:///./data/experiments.db

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Security & Credentials (never commit actual production secrets to git!)
SECRET_KEY=change-this-secret-key-in-production-use-strong-entropy
CORS_ORIGINS=["*"]
